# ============================================================
# MusicLens Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put these values in frontend/ or Vercel public env vars.
# ============================================================

# --- SERVER / LOCAL PIPELINE ONLY ---
# PostgreSQL (local, Neon, or Supabase). Used by pipeline/05_load_to_postgres.py
# and scripts/validate_db.py. Not used by the Vite frontend.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/musiclens

# Kaggle credentials are only needed for pipeline/01_download_data.py
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- Application ---
# Set to "development" or "production"
APP_ENV=development

# --- PUBLIC FRONTEND (Vite) ---
# The static dashboard does not require any VITE_* variables.
# If you add a public variable later, it MUST be prefixed with VITE_
# and must never contain DATABASE_URL, passwords, or Kaggle keys.
