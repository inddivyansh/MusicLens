# ============================================================
# MusicLens Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER prefix any of these with VITE_ — they must stay server-side only.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string.
# Used by: serverless API functions, Python pipeline, sql/migrate.js
# Format: postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
#         (for Node use the postgres:// variant — psycopg2 prefix is Python-only)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/musiclens?sslmode=require

# ── Spotify OAuth (server-side ONLY) ─────────────────────────────────────
# Create a Spotify Developer app at https://developer.spotify.com/dashboard
# Add your redirect URI to the app's Allowed Redirect URIs.
# NEVER expose these in VITE_* vars or client-side code.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Full callback URL — must match exactly what is registered in your Spotify app.
# Local dev:   http://localhost:3001/api/spotify/callback
# Production:  https://your-app.vercel.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/spotify/callback

# ── Token encryption (server-side ONLY) ──────────────────────────────────
# AES-256-GCM key for encrypting Spotify tokens at rest.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_locally

# ── Application URL ───────────────────────────────────────────────────────
# Base URL of the deployed app (no trailing slash).
# Used to build OAuth redirect responses.
# Local dev:   http://localhost:3001
# Production:  https://your-app.vercel.app
APP_BASE_URL=http://localhost:3001

# ── Python pipeline (local only) ─────────────────────────────────────────
# Kaggle credentials are only needed for pipeline/01_download_data.py
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development

# ── PUBLIC FRONTEND (Vite) ────────────────────────────────────────────────
# The frontend does NOT require any VITE_* variables for auth or Spotify.
# The httpOnly session cookie is managed entirely by the server.
# If you add a genuinely public variable later, prefix it with VITE_
# and ensure it contains NO secrets.
